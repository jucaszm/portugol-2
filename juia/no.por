programa
{
	
	funcao inicio()
	{
		inteiro A = 5
		inteiro B = 1
		inteiro C = 3
		inteiro D = 8
		
		inteiro result1 = A * B - C + D
		escreva(" O resultado de A: " + result1 + "\n" )
		
		inteiro result2 = A * (B - C)
		escreva(" O resultado de B: " + result2 + "\n" )
		
		inteiro result3 = A - C * + A
		escreva(" O resultado de C: " + result3 + "\n" )

		inteiro result4 = D * (B / 2)
		escreva(" O resultado de D: " + result4 + "\n" )

		inteiro result5 = B * D * A - C
		escreva(" O resultado de E: " + result5 + "\n" )

		inteiro result6 = 6 + 5 - 3 * 2
		escreva(" O resultado de F: " + result6 + "\n" )

		inteiro result7 = 9 / 3 + 5 * 2
		escreva(" O resultado de G: " + result7 + "\n" )

		inteiro result8 = (A + B + C) * D
		escreva(" O resultado de H: " + result8 + "\n" )
	}

}
