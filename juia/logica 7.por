programa
{
	
	funcao inicio()
	{
		inteiro numero

		escreva ("Digite o numero: ")
		leia(numero)
		
		se (numero > 0)
		{
			escreva ("numero positivo")
		}
		se (numero < 0)
		{
			escreva ("numero negativo")
		}
		se (numero ==0)
		{
			escreva ("numero é igual a zero")
		}
			
	}
}
