programa
{
	
	funcao inicio()
	{	
		inteiro idade [4] = {14, 15, 15, 16}
		 
		escreva("===== IDADES =====\n")

		escreva("primeira idade: " + idade [0] + "\n")
		escreva("ultima idade: " + idade [3]+ "\n")
		
	}
}
