programa
{
	
	funcao inicio()
	{
		cadeia senha
		
		escreva ("digite a senha: ")
		leia(senha)
		
		se (senha == "SENAI"){
		
			escreva ("Você acertou a palavra secreta!")}

		senao escreva ("Palavra errada, acesso negado.")
	}
}
