programa
{
	
	funcao inicio()
	{
		real numero1
		real numero2
		real soma, subtracao, multiplicaco, divisao

		escreva ("Digite o numero 1: ")
		leia (numero1)

		escreva ("Digite o numero 2: ")
		leia (numero2)

		escreva("soma: ", numero1 + numero2, "\n" )
		escreva("subtração: ", numero1 - numero2, "\n" )
		escreva("multiplicação: ", numero1 * numero2, "\n" )
		escreva("divisão: ", numero1 / numero2, "\n" )
		
		
	}
}
