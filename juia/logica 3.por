programa
{
	
	funcao inicio()
	{
		real nota 

		escreva ("Digite a nota: ")
		leia(nota)

		se (nota >= 7) {
			escreva ("Você está aprovado" + "\n")
		} senao {
			escreva ("Você está reprovado" + "\n")
		}
	}
}
