programa
{
	
	funcao inicio()
	{
		real ingresso = 20.00
		cadeia estudante
		real meia = ingresso / 2

		escreva("você é estudante? sim | não \n")
		leia(estudante)
		
		se(estudante == "sim"){
			escreva("o valor do ingresso é " + meia)
		}senao {
			escreva("o valor do ingresso é " + ingresso)
		}
	}
}
